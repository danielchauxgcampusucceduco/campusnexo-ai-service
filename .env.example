# Copia a .env (ignorado por git). Todos los valores aquí son marcadores.

# Servicio en Render: la misma clave que AI_API_KEY del backend, 24 caracteres o más. Vacía solo en local.
AI_API_KEY=
PORT=8001

# Borde, agentes de PC y prueba de carga.
CAMPUSNEXO_BACKEND_URL=http://localhost:8080
# Clave de sensor propia de cada dispositivo (una de APP_SENSOR_KEYS del backend), revocable por separado.
CAMPUSNEXO_SENSOR_KEY=
YOLO_MODEL=yolo11n.pt
